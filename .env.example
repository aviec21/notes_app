# Set these in Vercel: Project -> Settings -> Environment Variables (never commit real values).

# Random string of 32+ characters used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Random string that lets Vercel's daily cron job empty expired items from the recycle bin.
# (Vercel sends it automatically as "Authorization: Bearer <value>".)
CRON_SECRET=

# Added automatically when you connect Neon in Vercel (Storage tab).
# DATABASE_URL=
