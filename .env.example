# Set these in Vercel: Project -> Settings -> Environment Variables (never commit real values).

# The one email allowed to sign in (must also be the email of your Resend account).
ALLOWED_EMAIL=you@example.com

# Random string of 32+ characters: signs session cookies and hashes sign-in codes.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Resend API key (resend.com -> API Keys), used to email sign-in codes.
RESEND_API_KEY=

# Optional. Defaults to Resend's shared sender, which can only email your own Resend address.
# MAIL_FROM=Notes <onboarding@resend.dev>

# Added automatically when you connect Neon in Vercel (Storage tab).
# DATABASE_URL=
